{
	"name": "matraux/php-benchmark",
	"description": "Benchmarking tool for PHP 8.4+ to measure code performance with accurate time and memory profiling.",
	"keywords": ["PHP Benchmark", "php-benchmark", "MATRAUX"],
	"type": "library",
	"license": "MIT",
	"authors": [
		{
			"name": "Daniel Žůrek",
			"email": "info@danielzurek.cz",
			"homepage": "https://www.matraux.com"
		}
	],
	"require": {
		"php": ">=8.4"
	},
	"suggest": {
		"tracy/tracy": "Required only if you use Tracy",
		"symfony/console": "Required only if you use Symfony console"
	},
	"require-dev": {
		"phpstan/phpstan": "^2.1",
		"codeception/codeception": "^5.3",
		"codeception/module-asserts": "^3.3",
		"tracy/tracy": "^2.11",
		"symfony/console": "^8.0",
		"matraux/php-cs-fixer-config": "^2.0"
	},
	"autoload": {
		"psr-4": {
			"Matraux\\PhpBenchmark\\": "src"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Matraux\\PhpBenchmark\\Test\\": "tests"
		}
	},
	"support": {
		"issues": "https://github.com/matraux/php-benchmark/issues",
		"source": "https://github.com/matraux/php-benchmark"
	},
	"scripts": {
		"cs:check": "php-cs-fixer check --diff --using-cache no",
		"cs:fix": "php-cs-fixer fix --using-cache no",
		"phpstan": "phpstan analyse --ansi",
		"tests:build": "codecept build",
		"tests:run": "codecept run"
	},
	"scripts-descriptions": {
		"cs:check": "Check code style",
		"cs:fix": "Fix code style",
		"phpstan": "Static code analysis",
		"tests:build": "Build Codeception actors",
		"tests:run": "Run Codeception tests"
	}
}
